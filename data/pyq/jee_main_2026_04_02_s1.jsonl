{"pyq_id": "JEEM-2026-04-02-S1-Q01", "exam": "JEE_MAIN", "year": 2026, "shift": "02 Apr S1", "subject": "MATHEMATICS", "chapter": "Quadratic Equations", "topic": "roots of a summed quadratic", "question_format": "single_correct_mcq", "stem": "Let α, α+2, α ∈ Z, be the roots of the quadratic equation x(x+2) + (x+1)(x+3) + (x+2)(x+4) + .... + (x+n−1)(x+n+1) = 4n for some n ∈ N. Then n + α is equal to:", "options": [{"id": "A", "text": "0", "value": "0"}, {"id": "B", "text": "1", "value": "1"}, {"id": "C", "text": "2", "value": "2"}, {"id": "D", "text": "3", "value": "3"}], "answer_key": "C", "key_source": "unofficial_reference", "source": {"document": "JEE Main 2026 02-Apr Shift-1 (eSaral reproduction).pdf", "rights_status": "UNKNOWN", "permitted_uses": ["storage", "search"], "page": 1}, "extraction": {"method": "manual", "visual_review_done": true}, "formal": {"kind": "equation_system", "stem": "see record stem", "knowns": {}, "unknowns": {"n": {"unit": "", "domain": "natural"}, "a": {"unit": "", "domain": "integer"}, "t": {"unit": "", "domain": "real"}}, "equations": ["2*a + 2 = -(n + 1)", "a*(a + 2) = (n - 1)*(2*n - 1)/6 + (n - 1) - 4", "t = n + a"], "target": "t", "model": ["sum = n x^2 + n(n+1) x + (n-1)n(2n-1)/6 + n(n-1); equation divided by n", "monic quadratic x^2 + (n+1)x + [(n-1)(2n-1)/6 + (n-1) - 4] = 0 with roots a, a+2"]}}
{"pyq_id": "JEEM-2026-04-02-S1-Q27", "exam": "JEE_MAIN", "year": 2026, "shift": "02 Apr S1", "subject": "PHYSICS", "chapter": "Units and Measurements", "topic": "errors", "question_format": "single_correct_mcq", "stem": "The diameter of a wire measured by a screw gauge of least count 0.001 cm is 0.08 cm. The length measured by a scale of least count 0.1 cm is 150 cm. When a weight of 100 N is applied to the wire, the extension in length is 0.5 cm, measured by a micrometer of least count 0.001 cm. The error in the measured Young's modulus is α × 10^9 N/m^2. The value of α is ____. (Ignore the contribution of the load to Young's modulus error calculation)", "options": [{"id": "A", "text": "1.3", "value": "1.3"}, {"id": "B", "text": "1.65", "value": "1.65"}, {"id": "C", "text": "0.13", "value": "0.13"}, {"id": "D", "text": "0.25", "value": "0.25"}], "answer_key": "B", "key_source": "unofficial_reference", "source": {"document": "JEE Main 2026 02-Apr Shift-1 (eSaral reproduction).pdf", "rights_status": "UNKNOWN", "permitted_uses": ["storage", "search"], "page": 2}, "extraction": {"method": "manual", "visual_review_done": true}, "formal": {"kind": "equation_system", "options_rounded": {"rel_tol": "0.01"}, "knowns": {"F": {"value": "100", "unit": "N"}, "L": {"value": "150", "unit": "cm"}, "d": {"value": "0.08", "unit": "cm"}, "x": {"value": "0.5", "unit": "cm"}, "dd": {"value": "0.001", "unit": "cm"}, "dL": {"value": "0.1", "unit": "cm"}, "dx": {"value": "0.001", "unit": "cm"}, "u": {"value": "1", "unit": "GPa"}}, "unknowns": {"Y": {"unit": "Pa", "domain": "positive"}, "dY": {"unit": "Pa", "domain": "positive"}, "al": {"unit": "", "domain": "positive"}}, "equations": ["Y*pi*d**2*x = 4*F*L", "dY/Y = 2*dd/d + dL/L + dx/x", "dY = al*u"], "target": "al", "model": ["Y = 4FL/(pi d^2 x)", "maximum relative error adds; d enters squared"]}}
